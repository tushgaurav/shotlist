# Postgres on RDS. Use a dedicated database for this app (e.g. CREATE DATABASE shotlist;).
# RDS certificates are signed by Amazon's own CA, so point sslrootcert at the bundled CA file.
DATABASE_URL=postgres://USER:PASSWORD@HOST.rds.amazonaws.com:5432/shotlist?sslmode=verify-full&sslrootcert=certs/rds-global-bundle.pem

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Set to true after creating your own account to block new sign-ups.
DISABLE_SIGNUP=false

# Shot images. Leave empty to turn image uploads off.
# A private bucket (public access blocked) with a CORS rule allowing POST from the app's origin,
# and an IAM user allowed s3:PutObject and s3:GetObject on arn:aws:s3:::BUCKET/*.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible storage such as MinIO or Cloudflare R2.
S3_ENDPOINT=

# AI writing, through OpenRouter. Leave empty to turn the AI features off.
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
